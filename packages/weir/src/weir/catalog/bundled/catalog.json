{
  "sources": [
    {
      "name": "financial_account_identifier",
      "content_pattern": "\\b[A-Z]{0,2}[0-9]{6,34}\\b",
      "eligibility": {
        "structure_class": "iban",
        "min_length": null,
        "pattern": null
      }
    },
    {
      "name": "github_token",
      "content_pattern": "\\bghp_[A-Za-z0-9]+\\b",
      "exposure": true,
      "eligibility": {
        "structure_class": null,
        "min_length": null,
        "pattern": "ghp_[A-Za-z0-9]{36}",
        "min_distinct_chars": 8,
        "reject_patterns": [
          "(?i)ghp_(x|0|#)+",
          "(?i)ghp_(EXAMPLE|TEST|FAKE|DEMO|PLACEHOLDER|REDACTED).*"
        ]
      }
    },
    {
      "name": "openai_api_key",
      "content_pattern": "\\bsk-[A-Za-z0-9_-]{16,}",
      "exposure": true,
      "eligibility": {
        "pattern": "sk-(proj-|svcacct-)?[A-Za-z0-9_-]{32,200}",
        "min_distinct_chars": 8,
        "reject_patterns": [
          "(?i)sk-(proj-|svcacct-)?(x|0|#)+",
          "(?i)sk-(proj-|svcacct-)?(EXAMPLE|TEST|FAKE|DEMO|PLACEHOLDER|REDACTED).*"
        ]
      }
    },
    {
      "name": "anthropic_api_key",
      "content_pattern": "\\bsk-ant-[A-Za-z0-9_-]{16,}",
      "exposure": true,
      "eligibility": {
        "pattern": "sk-ant-(api|admin)\\d{2}-[A-Za-z0-9_-]{60,200}",
        "min_distinct_chars": 8,
        "reject_patterns": [
          "(?i)sk-ant-(api|admin)\\d{2}-(x|0|#)+",
          "(?i)sk-ant-(api|admin)\\d{2}-(EXAMPLE|TEST|FAKE|DEMO|PLACEHOLDER|REDACTED).*"
        ]
      }
    },
    {
      "name": "aws_access_key_id",
      "content_pattern": "\\b(?:AKIA|ASIA)[A-Z0-9]{8,}",
      "exposure": true,
      "eligibility": {
        "pattern": "(AKIA|ASIA)[A-Z0-9]{16}",
        "min_distinct_chars": 8,
        "reject_patterns": [
          "(AKIA|ASIA)(X|0|#)+",
          "AKIAIOSFODNN7EXAMPLE"
        ]
      }
    },
    {
      "name": "google_api_key",
      "content_pattern": "\\bAIza[A-Za-z0-9_-]{16,}",
      "exposure": true,
      "eligibility": {
        "pattern": "AIza[A-Za-z0-9_-]{35}",
        "min_distinct_chars": 8,
        "reject_patterns": [
          "(?i)AIza(x|0|#)+",
          "(?i)AIza(EXAMPLE|TEST|FAKE|DEMO|PLACEHOLDER|REDACTED).*"
        ]
      }
    },
    {
      "name": "credential_field",
      "content_pattern": "(?i)(?<![A-Za-z0-9])(?:(?:private|secret|access|client|refresh)[_-]?(?:key|secret|token)|api[_-]?key|apikey|secret|token|password|passwd)\\s*[=:]\\s*['\"]?([^'\"\\s,;)}\\]]{8,})",
      "exposure": true,
      "eligibility": {
        "reject_patterns": [
          "[*xX#]+",
          "(?i)(None|null|REDACTED)"
        ]
      }
    }
  ],
  "sinks": [
    {
      "tool_name": "send_email",
      "destination_arg_keys": [
        "to"
      ]
    },
    {
      "tool_name": "post_to_webhook",
      "destination_arg_keys": [
        "url"
      ]
    }
  ],
  "remediations": {
    "langchain": "tool arguments not captured - capture mechanisms vary by instrumentation package; for OTel GenAI instrumentations built on the util-genai layer, set OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental and OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=SPAN_ONLY (content is off by default; weir reads span attributes)"
  },
  "scope_remediations": {
    "opentelemetry.instrumentation.langchain": "tool arguments not captured - this scope is emitted by Traceloop/OpenLLMetry's LangChain instrumentation, which captures content to span attributes by default; check TRACELOOP_TRACE_CONTENT (false disables capture) in the traced service's environment"
  },
  "untrusted_sources": []
}
