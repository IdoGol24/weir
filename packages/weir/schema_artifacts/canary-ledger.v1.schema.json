{
  "$defs": {
    "Direct": {
      "additionalProperties": false,
      "description": "A connection a flow tried to open around the mock, blocked by\n    isolation. Never content: a protocol, a target and a count.",
      "properties": {
        "attempts": {
          "minimum": 1,
          "type": "integer"
        },
        "flow": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:#/-]{1,128}$",
          "type": "string"
        },
        "protocol": {
          "enum": [
            "dns",
            "tcp",
            "udp"
          ]
        },
        "target": {
          "maxLength": 260,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:\\[\\]-]{1,260}$",
          "type": "string"
        },
        "type": {
          "enum": [
            "direct"
          ]
        }
      },
      "required": [
        "type",
        "flow",
        "protocol",
        "target",
        "attempts"
      ],
      "title": "Direct",
      "type": "object"
    },
    "Exercised": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "enum": [
            "egress",
            "minted",
            "request",
            "tool_call"
          ]
        },
        "placement": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:#/-]{1,128}$",
          "type": "string"
        },
        "type": {
          "enum": [
            "exercised"
          ]
        }
      },
      "required": [
        "type",
        "placement",
        "evidence"
      ],
      "title": "Exercised",
      "type": "object"
    },
    "Flow": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:#/-]{1,128}$",
          "type": "string"
        },
        "status": {
          "enum": [
            "failed",
            "ok",
            "skipped",
            "timeout"
          ]
        },
        "telemetry": {
          "default": true,
          "type": "boolean"
        },
        "type": {
          "enum": [
            "flow"
          ]
        }
      },
      "required": [
        "type",
        "id",
        "status"
      ],
      "title": "Flow",
      "type": "object"
    },
    "LedgerHeader": {
      "additionalProperties": false,
      "description": "The first line of every ledger.",
      "properties": {
        "schema": {
          "enum": [
            "canary-ledger/1"
          ]
        }
      },
      "required": [
        "schema"
      ],
      "title": "LedgerHeader",
      "type": "object"
    },
    "Network": {
      "additionalProperties": false,
      "description": "Whether the flows ran with no route out but loopback. At most one.",
      "properties": {
        "isolated": {
          "type": "boolean"
        },
        "required": {
          "default": false,
          "type": "boolean"
        },
        "type": {
          "enum": [
            "network"
          ]
        }
      },
      "required": [
        "type",
        "isolated"
      ],
      "title": "Network",
      "type": "object"
    },
    "Placement": {
      "additionalProperties": false,
      "description": "One place a credential can live, holding one fake value.",
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:#/-]{1,128}$",
          "type": "string"
        },
        "kind": {
          "enum": [
            "code",
            "env",
            "file",
            "mock-oauth"
          ]
        },
        "provider_host": {
          "anyOf": [
            {
              "maxLength": 253,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:-]{1,253}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "providers": {
          "default": [],
          "items": {
            "maxLength": 40,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]{1,40}$",
            "type": "string"
          },
          "type": "array"
        },
        "required": {
          "default": false,
          "type": "boolean"
        },
        "type": {
          "enum": [
            "placement"
          ]
        },
        "value": {
          "minLength": 16,
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "kind",
        "value"
      ],
      "title": "Placement",
      "type": "object"
    },
    "Unexpected": {
      "additionalProperties": false,
      "description": "A credential field the mock received that held no needle. Never a value.",
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:#/-]{1,128}$",
          "type": "string"
        },
        "type": {
          "enum": [
            "unexpected"
          ]
        }
      },
      "required": [
        "type",
        "id"
      ],
      "title": "Unexpected",
      "type": "object"
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/LedgerHeader"
    },
    {
      "anyOf": [
        {
          "$ref": "#/$defs/Placement"
        },
        {
          "$ref": "#/$defs/Exercised"
        },
        {
          "$ref": "#/$defs/Flow"
        },
        {
          "$ref": "#/$defs/Unexpected"
        },
        {
          "$ref": "#/$defs/Network"
        },
        {
          "$ref": "#/$defs/Direct"
        }
      ],
      "discriminator": {
        "mapping": {
          "direct": "#/$defs/Direct",
          "exercised": "#/$defs/Exercised",
          "flow": "#/$defs/Flow",
          "network": "#/$defs/Network",
          "placement": "#/$defs/Placement",
          "unexpected": "#/$defs/Unexpected"
        },
        "propertyName": "type"
      }
    }
  ]
}
