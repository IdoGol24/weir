# Fixtures are byte-exact artifacts compared by drift tests via read_bytes();
# EOL smudging on checkout (core.autocrlf) would break every byte-compare on
# a fresh Windows clone. No conversion, ever.
fixtures/** -text
# The bundled sample ships in the wheel and is byte-compared against the
# corpus fixture; EOL smudging would both fail the drift test on fresh
# Windows checkouts and make wheels platform-dependent.
packages/weir/src/weir/data/** -text
# The README hero is generated from live CLI output and drift-compared. It
# survives smudging today only because the test reads it as text; this keeps
# it honest if that ever becomes a read_bytes() compare like the others.
docs/assets/** -text
